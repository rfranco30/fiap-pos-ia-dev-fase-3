# Configuracao do Ollama (local)
# Nao precisa de chave de API - Ollama roda localmente

# Modelo para usar (baixe com: ollama pull llama3.2)
OLLAMA_MODEL=llama3.2

# URL do Ollama (padrao: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Modelos alternativos (descomente para usar):
# OLLAMA_MODEL=llama3.2:1b
# OLLAMA_MODEL=phi3
# OLLAMA_MODEL=mistral
# OLLAMA_MODEL=codellama
